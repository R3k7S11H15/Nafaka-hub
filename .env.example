# Environment
NODE_ENV=development
PORT=5173

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=jumla_rice_trading

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES=7d

# API
API_BASE_URL=http://localhost:3000/api

# Admin
ADMIN_EMAIL=admin@nafaka.co.tz
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_RATE_LIMIT_MAX_REQUESTS=30

# NTZS Partner API — collections, disbursements, bills, treasury
# No `wallets` capability: collections land in the partner treasury.
# Test mode: use ntzs_test_ keys. Production: use ntzs_live_ keys.
NTZS_API_BASE=https://www.ntzs.co.tz/api/v1
NTZS_API_KEY=ntzs_test_YOUR_REAL_TEST_KEY
NTZS_WEBHOOK_SECRET=whsec_YOUR_TEST_SECRET
# No nTZS holder id is needed. As of API v1.28.0 the partner treasury is tied to
# the API key: collections name no receiving holder and carry `endUser` (our own
# customer id) instead, and payouts and bills pay from the treasury float with
# fromTreasury: true. The two values below are optional overrides only — leave
# them empty on this account.
NTZS_COLLECTION_USER_ID=
NTZS_FUNDING_USER_ID=
# The treasury settlement address we hold. Never an nTZS identifier.
NTZS_TREASURY_SETTLEMENT_ADDRESS=0xF44A0b9812064de033cf4CcA9aED21d4c2494eA8
# nTZS takes 8-12s to initiate a collection (measured); allow headroom.
NTZS_TIMEOUT_MS=30000
