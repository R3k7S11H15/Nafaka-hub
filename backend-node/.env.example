# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=jumla_rice_trading

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_LOCAL_NETWORK=true
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_RATE_LIMIT_MAX_REQUESTS=30

# CSRF
CSRF_SECRET=your-csrf-secret-change-in-production

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Webhook
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRY_ATTEMPTS=3

# NTZS Mobile Money Provider (deposits / wallet top-ups)
# Test mode: use ntzs_test_ keys. Production: use ntzs_live_ keys.
NTZS_API_BASE=https://www.ntzs.co.tz/api/v1
NTZS_API_KEY=ntzs_live_80d72f887b6dfc4698cf7f3885f93f6c0b18eb65
NTZS_WEBHOOK_SECRET=whsec_67afc167b615c2644e7e9b90420333dc446188d4f1550b9e
NTZS_COLLECT_TO_TREASURY=true
